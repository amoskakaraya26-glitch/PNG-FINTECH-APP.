# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=png_wallet_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=change_this_to_a_random_secret

# App
PORT=3000
NODE_ENV=development

# AI (Optional)
OPENAI_API_KEY=your_openai_api_key

# Frontend
FRONTEND_URL=http://localhost:3001

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email
SMTP_PASS=your_password

# Savis Integration
# Set true only for local testing without real Savis credentials
SAVIS_USE_MOCK=false
SAVIS_API_KEY=your_savis_api_key
SAVIS_BASE_URL=https://your-real-savis-api-domain

# SevisPass Integration (PNG Digital ID)
# Set true only for local testing without real SevisPass credentials
SEVISPASS_USE_MOCK=false
SEVISPASS_CLIENT_ID=your_sevispass_client_id
SEVISPASS_CLIENT_SECRET=your_sevispass_client_secret
SEVISPASS_AUTH_URL=https://your-real-sevispass-auth-domain
SEVISPASS_API_URL=https://your-real-sevispass-api-domain
SEVISPASS_REDIRECT_URI=http://localhost:3000/api/auth/sevispass/callback

# Banking Integrations
# Set true only for local testing without real bank credentials
BANKS_USE_MOCK=false
KINA_API_KEY=your_kina_api_key
KINA_BASE_URL=https://your-real-kina-api-domain
BSP_API_KEY=your_bsp_api_key
BSP_BASE_URL=https://your-real-bsp-api-domain
