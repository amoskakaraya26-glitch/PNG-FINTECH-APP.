# ============================================
# PNG FINTECH APP - PRODUCTION ENVIRONMENT
# Copy this to .env.production and fill in values
# NEVER commit .env.production to git
# ============================================

# App
NODE_ENV=production
PORT=3000

# Database - use DATABASE_URL for cloud DBs (Neon, Supabase, Render, Railway)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OR use individual vars for local/Docker PostgreSQL:
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=png_wallet_db
# DB_USER=postgres
# DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Security - MUST be changed in production (use a 64-char random string)
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_STRING_MIN_64_CHARS
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_KEY

# CORS - set to your actual frontend URL
FRONTEND_URL=https://your-app.onrender.com

# SevisPass OAuth (required for real integration)
SEVISPASS_USE_MOCK=false
SEVISPASS_CLIENT_ID=your_real_sevispass_client_id
SEVISPASS_CLIENT_SECRET=your_real_sevispass_client_secret
SEVISPASS_AUTH_URL=https://your-real-sevispass-auth-domain
SEVISPASS_API_URL=https://your-real-sevispass-api-domain
SEVISPASS_REDIRECT_URI=https://your-api-domain/api/auth/sevispass/callback

# Optional: AI Assistant
OPENAI_API_KEY=

# Optional: Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password

# Optional: Bank integrations
SAVIS_USE_MOCK=false
SAVIS_API_KEY=
SAVIS_BASE_URL=https://your-real-savis-api-domain
BANKS_USE_MOCK=false
KINA_API_KEY=
KINA_BASE_URL=https://your-real-kina-api-domain
BSP_API_KEY=
BSP_BASE_URL=https://your-real-bsp-api-domain
